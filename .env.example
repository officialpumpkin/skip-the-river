# Copy this file to .env.local and fill in your Firebase project credentials.
# Get these from: Firebase Console → Project Settings → Your apps → Web app → SDK setup
#
# IMPORTANT: .env.local is git-ignored. Never commit real credentials.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
